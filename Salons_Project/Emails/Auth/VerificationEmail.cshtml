@using System
@model Salons_Project.Application.Emails.EmailVerificationModel
@{
    // Brand palette — Maison Lueur "quiet luxury"
    const string Bg         = "#FAF7F2"; // Background
    const string CardBg     = "#FFFFFF";
    const string Text       = "#2A2A2A"; // Text
    const string Accent     = "#C6A96A"; // Accent (champagne)
    const string AccentDeep = "#B4945A";
    const string Secondary  = "#8B6B5C"; // Secondary (mocha)
    const string MochaDeep  = "#5E463C";
    const string Line        = "#DED3C4";
    const string Muted       = "#7A7268";
    const string CodeBg      = "#FBF7EF";

    // Not carried by the record — static here. Promote to model properties later if needed.
    const int expiryMinutes    = 10;
    const string supportEmail  = "hello@maisonlueur.com";

    var greeting = string.IsNullOrWhiteSpace(Model.Username)
        ? "Hello,"
        : $"Hello {Model.Username.Trim()},";
    var preheader = $"Your verification code is {Model.Code}. It expires in {expiryMinutes} minutes.";
    var year = DateTime.UtcNow.Year;
}<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:v="urn:schemas-microsoft-com:vml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="color-scheme" content="light">
    <meta name="supported-color-schemes" content="light">
    <title>Verification code</title>
    <!--[if mso]>
    <noscript><xml><o:OfficeDocumentSettings><o:PixelsPerInch>96</o:PixelsPerInch></o:OfficeDocumentSettings></xml></noscript>
    <![endif]-->
    <style>
    /* Progressive fonts for clients that support web fonts (Apple Mail, iOS). */
    @@import url('https://fonts.googleapis.com/css2?family=Fraunces:wght@@400;500&family=Manrope:wght@@400;600;700&display=swap');
    body, table, td, a { -webkit-text-size-adjust:100%; -ms-text-size-adjust:100%; }
    table, td { mso-table-lspace:0pt; mso-table-rspace:0pt; }
    img { -ms-interpolation-mode:bicubic; border:0; line-height:100%; outline:none; text-decoration:none; }
    body { margin:0; padding:0; width:100% !important; background:@Bg; }
    .display { font-family:'Fraunces', Georgia, 'Times New Roman', serif; }
    .sans    { font-family:'Manrope', 'Segoe UI', Arial, Helvetica, sans-serif; }
    @@media only screen and (max-width:620px){
      .container { width:100% !important; }
      .px { padding-left:24px !important; padding-right:24px !important; }
      .code-cell { font-size:30px !important; letter-spacing:6px !important; }
    }
    </style>
</head>
<body style="margin:0; padding:0; background:@Bg;">
    <!-- Preheader (hidden preview text) -->
    <div style="display:none; max-height:0; overflow:hidden; opacity:0; color:@Bg; font-size:1px; line-height:1px;">
        @preheader&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;&nbsp;
    </div>

    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:@Bg;">
        <tr>
            <td align="center" style="padding:32px 16px;">

                <table role="presentation" class="container" width="600" cellpadding="0" cellspacing="0" border="0" style="width:600px; max-width:600px; background:@CardBg; border:1px solid @Line; border-radius:16px; overflow:hidden;">

                    <!-- Header band -->
                    <tr>
                        <td align="center" style="background:@MochaDeep; padding:28px 24px;">
                            <div class="display" style="color:#F3ECE2; font-size:22px; letter-spacing:6px; text-transform:uppercase; font-weight:500;">
                                Maison <span style="color:@Accent;">Lueur</span>
                            </div>
                            <div class="sans" style="color:rgba(243,236,226,0.62); font-size:10px; letter-spacing:5px; text-transform:uppercase; padding-top:6px;">
                                Beauty Atelier
                            </div>
                        </td>
                    </tr>

                    <!-- Body -->
                    <tr>
                        <td class="px" style="padding:40px 48px 8px 48px;">
                            <div class="sans" style="color:@Secondary; font-size:11px; letter-spacing:3px; text-transform:uppercase; font-weight:600;">
                                Verify your email
                            </div>
                            <div class="display" style="color:@Text; font-size:28px; line-height:1.2; padding-top:10px;">
                                @greeting
                            </div>
                            <p class="sans" style="color:@Muted; font-size:15px; line-height:1.6; margin:14px 0 0 0;">
                                Use the code below to confirm your email and unlock your account. It keeps your appointments and history yours alone.
                            </p>
                        </td>
                    </tr>

                    <!-- Code -->
                    <tr>
                        <td class="px" style="padding:24px 48px 8px 48px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td class="code-cell display" align="center" style="background:@CodeBg; border:1px solid @Accent; border-radius:12px; padding:22px 12px; color:@Text; font-size:38px; font-weight:500; letter-spacing:10px;">
                                        @Model.Code
                                    </td>
                                </tr>
                            </table>
                            <p class="sans" style="color:@Muted; font-size:13px; line-height:1.5; text-align:center; margin:14px 0 0 0;">
                                This code expires in @expiryMinutes minutes.
                            </p>
                        </td>
                    </tr>

                    @if (!string.IsNullOrWhiteSpace(Model.VerificationLink))
                    {
                        <!-- CTA button -->
                        <tr>
                            <td class="px" align="center" style="padding:20px 48px 4px 48px;">
                                <!--[if mso]>
                                <v:roundrect xmlns:v="urn:schemas-microsoft-com:vml" xmlns:w="urn:schemas-microsoft-com:office:word" href="@Model.VerificationLink" style="height:48px;v-text-anchor:middle;width:260px;" arcsize="25%" strokecolor="@AccentDeep" fillcolor="@Accent">
                                  <w:anchorlock/>
                                  <center style="color:#2A2116;font-family:Arial,sans-serif;font-size:14px;font-weight:bold;letter-spacing:1px;">VERIFY EMAIL</center>
                                </v:roundrect>
                                <![endif]-->
                                <!--[if !mso]><!-- -->
                                <a href="@Model.VerificationLink" class="sans" style="display:inline-block; background:@Accent; color:#2A2116; font-size:14px; font-weight:700; letter-spacing:1px; text-transform:uppercase; text-decoration:none; padding:15px 34px; border-radius:12px;">
                                    Verify email
                                </a>
                                <!--<![endif]-->
                            </td>
                        </tr>
                    }

                    <!-- Reassurance -->
                    <tr>
                        <td class="px" style="padding:20px 48px 8px 48px;">
                            <p class="sans" style="color:@Muted; font-size:13px; line-height:1.6; margin:0;">
                                Didn't ask for this? You can safely ignore this email &mdash; nothing changes, and your account stays secure.
                            </p>
                        </td>
                    </tr>

                    <!-- Divider -->
                    <tr>
                        <td class="px" style="padding:24px 48px 0 48px;">
                            <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td style="border-top:1px solid @Line; font-size:0; line-height:0;">&nbsp;</td>
                                </tr>
                            </table>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td class="px" align="center" style="padding:22px 48px 34px 48px;">
                            <div class="sans" style="color:@Muted; font-size:12px; line-height:1.7;">
                                Maison Lueur &middot; 27 Lower Haven, Tbilisi 0108<br>
                                Need help? <a href="mailto:@supportEmail" style="color:@Secondary; text-decoration:none;">@supportEmail</a>
                            </div>
                            <div class="sans" style="color:#B4AB9E; font-size:11px; padding-top:12px;">
                                &copy; @year Maison Lueur. All rights reserved.
                            </div>
                        </td>
                    </tr>

                </table>

            </td>
        </tr>
    </table>
</body>
</html>
